# 福彩推荐系统环境变量模板
# 复制为 .env 并填写实际值：copy .env.example .env

# 必填：登录密码（无默认值，缺失时服务拒绝启动）
LOTTERY_PASS=

# 可选：登录用户名（默认 admin）
LOTTERY_USER=admin

# 可选：调试模式（默认 true；生产环境设为 false 以启用 cookie Secure 标志）
DEBUG=true

# 可选：服务端口（默认 8000；DevCloud 部署必须 8080）
PORT=8000

# 可选：CORS 允许的来源，逗号分隔（默认 http://localhost:8000,http://127.0.0.1:8000）
# DevCloud 部署时需设置为实际域名，例如:
# CORS_ORIGINS=https://your-app.devcloud.jd.com,http://localhost:8000
CORS_ORIGINS=

# 可选：天行数据 API key（用于补充数据源）
TIANYAN_API_KEY=